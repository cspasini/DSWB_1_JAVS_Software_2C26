doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Ingreso - Urbana Cult
        link(rel="stylesheet", href="/css/cartelera.css")
        link(rel="stylesheet", href="/css/login.css")
    body
        .container.login
            h1 Urbana Cult
            p.sub Ingreso a la plataforma

            #mensaje(role="status", aria-live="polite", hidden)

            section.panel
                form#login-form(novalidate)
                    .campos
                        label
                            | Usuario
                            input(type="text", name="usuario", autocomplete="username", autocapitalize="none", spellcheck="false", required, maxlength="50")
                        label
                            | Contraseña
                            input(type="password", name="clave", autocomplete="current-password", required, maxlength="128")
                    .botones
                        button#btn-ingresar.btn.btn-principal(type="submit") Ingresar

            p.login-pie Infraestructura Digital para la Circulación Cultural Independiente — Desarrollado por JAVS Software

        script(type="module", src="/js/login.js")