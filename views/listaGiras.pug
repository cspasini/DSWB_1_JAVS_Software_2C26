- const puedeEditar = usuario && ["admin", "espacio"].includes(usuario.rol)
doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Cartelera - Urbana Cult
        link(rel="stylesheet", href="/css/cartelera.css")
        link(rel="stylesheet", href="/css/funciones.css")
    body(data-puede-editar=puedeEditar ? "true" : "false")
        .container
            .barra
                a.volver(href="/") ← Volver al inicio
                if usuario
                    .sesion
                        span Sesión: #{usuario.usuario}
                        button#btn-salir.btn(type="button") Cerrar sesión

            h1 Urbana Cult — Cartelera Central de Giras
            p.sub Infraestructura Digital para la Circulación Cultural Independiente (Desarrollado por JAVS Software)

            #mensaje(role="status", aria-live="polite", hidden)

            //- El formulario solo se dibuja para admin y espacio. La seguridad real está en el servidor (permitirRoles).
            if puedeEditar
                section.panel
                    h2#form-titulo Nueva travesía
                    form#gira-form(novalidate)
                        .campos
                            label
                                | Artista
                                input(type="text", name="artista", required, maxlength="100")
                            label
                                | Nombre del tour
                                input(type="text", name="nombreTour", required, maxlength="100")
                            label
                                | Origen
                                input(type="text", name="origen", required, maxlength="100")
                            label
                                | Destino
                                input(type="text", name="destino", required, maxlength="100")
                            label
                                | Estado
                                select(name="estado")
                                    each estado in estados
                                        option(value=estado)= estado
                        .botones
                            button#btn-guardar.btn.btn-principal(type="submit") Publicar travesía
                            button#btn-cancelar.btn(type="button", hidden) Cancelar edición

            //- Primer pintado desde el servidor; después public/js/cartelera.js lo reemplaza con fetch (incluye las funciones).
            section#lista-giras
                if giras.length === 0
                    p.vacio Todavía no hay travesías publicadas.
                each gira in giras
                    article.card(data-id=gira.id)
                        h2.card-titulo
                            | #{gira.artista} —
                            span.badge(class=gira.estado.toLowerCase()) #{gira.estado}
                        p.tour Tour: #{gira.nombreTour}
                        .info
                            p
                                | 📍
                                strong Ruta de Circulación:
                                |  Nodal #{gira.origen} ➔ Nodal #{gira.destino} (Eje Dual)
                        h3.funciones-titulo Funciones
                        ul.funciones
                            li.vacio Cargando funciones…
                        .acciones
                            a.btn(href="/boleteria") Comprar entradas
                            if puedeEditar
                                button.btn(type="button", data-accion="editar") Editar
                                button.btn.btn-peligro(type="button", data-accion="eliminar") Eliminar

        script(src="/socket.io/socket.io.js")
        script(type="module", src="/js/sesion.js")
        script(type="module", src="/js/cartelera.js")