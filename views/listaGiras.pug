doctype html
html(lang="es")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Cartelera - Urbana Cult
        style.
            body { font-family: 'Segoe UI', Arial, sans-serif; background-color: #f4f7f6; margin: 0; padding: 40px; color: #333; }
            .container { max-width: 900px; margin: 0 auto; }
            h1 { color: #111; border-bottom: 2px solid #000; padding-bottom: 10px; }
            .sub { color: #666; font-style: italic; margin-bottom: 30px; }
            .card { background: white; padding: 20px; margin-bottom: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #000; }
            .badge { background: #e3faf2; color: #0ca678; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
            .info { font-size: 14px; color: #555; margin-top: 8px; }
    body
        .container
            h1 Urbana Cult — Cartelera Central de Giras
            p.sub Infraestructura Digital para la Circulación Cultural Independiente (Desarrollado por JAVS Software)
            
            each gira in giras
                .card
                    h2 #{gira.artista} — 
                        span.badge #{gira.estado}
                    p(style="margin: 5px 0; font-weight: bold; color: #2b6cb0;") Tour: #{gira.nombreTour}
                    .info
                        p 📍 <strong>Ruta de Circulación:</strong> Nodal #{gira.origen} ➔ Nodal #{gira.destino} (Eje Dual)
                        p 👥 <strong>Aforo Sincronizado:</strong> #{gira.aforoTotal} localidades disponibles (Inventario Único)
